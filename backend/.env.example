APP_NAME="Trading Expo India"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (MySQL only) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradingexpo
DB_USERNAME=tradingexpo
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Mail ---
# "log" writes emails to storage/logs/laravel.log (safe default).
# For real delivery on cPanel, switch to smtp and fill in the credentials.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="Trading Expo India"

# --- Trading Expo India settings ---
# Portal admin login. Set a strong password, then create the admin row with:
#   php artisan db:seed --class=AdminUserSeeder
ADMIN_USER=admin
ADMIN_PASSWORD=
# ...or instead of ADMIN_PASSWORD, a bcrypt hash (generate with: php artisan tinker -> bcrypt('secret'))
ADMIN_PASSWORD_HASH=

# Organizer inbox for contact-form notifications (empty = no email, still stored)
CONTACT_TO=

# Public frontend origin(s), comma-separated — used for CORS.
# Example: FRONTEND_URL=https://dawoodshah2232-svg.github.io
FRONTEND_URL=
